# ─── Server Configuration ───────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
DISPLAY_HOST=localhost
STORAGE_DIR=./storage
TITLE=Debian File Repository

# ─── Admin Authentication ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# Generate secret dengan perintah: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_random_64_char_hex_string

# ─── Docker Image Version ──────────────────────────────────────────────────
# Tag image GHCR yang digunakan di docker-compose (misal: latest, v1.0.0, 1.0.0).
# Menentukan versi rilis spesifik disarankan untuk menjaga stabilitas dan riwayat versi.
SWIRL_MIRROR_VERSION=v1.0.0

